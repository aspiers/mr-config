[$HOME/software/AI/whispering]
skip = lazy
checkout = github_clone
lib =
    set_git_origin_user epicenter-so
    set_git_origin_name epicenter
    set_git_clone_name epicenter
remotes = auto_remotes
fixups =
    source ~/.nvm/nvm.sh
    nvm use 22
    bun install
    node=$( nvm which 22 )
    node_bin=$( dirname "$node" )
    cat <<EOF >~/bin/$MR_NAME
    #!/bin/bash
    # Auto-generated by mrf $MR_NAME at `date`

    export PATH="$node_bin:\$PATH"
    cd "$MR_REPO"

    # Only needed on ionian?
    # export WEBKIT_DISABLE_COMPOSITING_MODE=1

    # Whispering has no native shell of its own any more; apps/epicenter is
    # the Tauri host that bundles it (see build:whispering).
    bun run dev:epicenter "\$@"
    EOF
    chmod +x ~/bin/$MR_NAME

