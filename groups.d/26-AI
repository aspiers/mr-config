[$HOME/.GIT/3rd-party/bead-me-up-scotty]
checkout = github_clone
remotes =
    auto_remotes
    configure_scotty_origin
lib =
    set_git_origin_user brendan-appstart
    configure_scotty_origin () {
        # The unattended update check only needs public read access.  Keep
        # pushes on SSH without giving the service access to an SSH agent.
        git -C "$MR_REPO" remote set-url origin \
            https://github.com/brendan-appstart/bead-me-up-scotty.git
        git -C "$MR_REPO" remote set-url --push origin \
            git@github.com:brendan-appstart/bead-me-up-scotty.git
    }
fixups =
    configure_scotty_origin
    source ~/.nvm/nvm.sh
    nvm use 22
    npm install
    npm run build
    npm link

    # Autostart the board on login as a systemd --user service.
    #
    # scripts/serve.mjs rather than `next start` directly: it respawns the
    # server when the app's "Update now" button exits it with code 75, which
    # is what lets a self-update come back on the newly built code.  Not
    # `npm run dev`, which is a watching, on-demand-compiling dev server with
    # nothing to swap in on update.
    #
    # Not the `scotty` launcher either: it auto-picks a free port (so the URL
    # moves) and spawns a browser, neither of which suits a daemon.
    #
    # Port 19847 is unregistered in /etc/services and below the ephemeral
    # range (32768-60999), so the kernel will never assign it to an outbound
    # socket.  Bound to loopback: the board is unauthenticated.
    #
    # $node is resolved via nvm rather than hardcoded, so a node upgrade
    # doesn't leave the unit pointing at a version that has been removed.
    node=$( nvm which 22 )
    mkdir -p ~/.config/systemd/user
    cat <<EOF >~/.config/systemd/user/scotty.service
    [Unit]
    Description=Bead Me Up, Scotty - beads web UI
    Documentation=https://github.com/brendan-appstart/bead-me-up-scotty

    # Auto-generated by mrf $MR_NAME at `date`; edit the fixups in
    # ~/.config/mr/groups.d/26-AI rather than this file.

    # adam-session.target rather than default.target: Scotty is headless and
    # needs no X, but it is a desktop tool, so it should come and go with the
    # desktop session.  Same target as sussurro/beeper/keyboard-watcher.
    #
    # Not graphical-session.target: that target cannot deactivate here, so
    # units on it never restart with the session (verified 2026-09-11; see
    # dc-m6n in desktop-config).
    PartOf=adam-session.target
    After=adam-session.target

    [Service]
    SyslogIdentifier=scotty

    Environment=PORT=19847
    Environment=HOST=127.0.0.1
    # Update checks fetch the public origin over HTTPS, configured above, so
    # this service deliberately receives no SSH_AUTH_SOCK.
    WorkingDirectory=$MR_REPO
    ExecStart=$node scripts/serve.mjs

    Restart=no

    # serve.mjs forks \`next start\`; kill the whole group so a stopped run
    # cannot leave a child holding port 19847 and block the next start with
    # EADDRINUSE.
    KillMode=control-group
    TimeoutStopSec=15s

    StandardOutput=journal
    StandardError=journal

    [Install]
    WantedBy=adam-session.target
    EOF
    systemctl --user daemon-reload
    systemctl --user enable scotty.service
    systemctl --user restart scotty.service

