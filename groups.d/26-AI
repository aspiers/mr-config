[$HOME/software/AI/orca]
checkout = github_clone
remotes =
    auto_remotes
    github_readwrite_remote aspiers
lib =
    set_git_origin_user stablyai
fixups =
    source ~/.nvm/nvm.sh
    # package.json pins engines.node to 24; 22 is too old for this build.
    nvm use 24
    corepack enable
    pnpm install
    # Only the CLI, not the full build:desktop/build:linux: the packaged
    # AppImage is already installed via ~/.cache/orca/appimage, so only the
    # dev CLI is worth building from this checkout.
    #
    # build:cli's two real steps are inlined rather than calling the script,
    # because it also runs install-dev-cli.mjs, which hardcodes a symlink in
    # /usr/local/bin/orca-dev with no override and tells you to re-run under
    # sudo.  We keep the wrapper in ~/bin like everything else mr installs.
    pnpm exec tsc -p config/tsconfig.cli.json \
        --outDir out --composite false --incremental false
    node config/scripts/verify-cli-bin.mjs --fix-executable --fix-package-json
    ensure_symlink_exists ~/bin/orca-dev "$MR_REPO/config/scripts/orca-dev.mjs"

