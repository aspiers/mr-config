[$HOME/.GIT/3rd-party/octobox]
skip = lazy || missing_exes git docker openssl
lib =
    set_git_origin_user octobox
checkout = github_clone_ro_origin
remotes = auto_remotes
fixups =
    cd "$MR_REPO"
    if ! [ -e .env ]; then
        cp .env.example .env
    fi
    if ! grep -q '^OCTOBOX_ATTRIBUTE_ENCRYPTION_KEY=' .env; then
        printf 'OCTOBOX_ATTRIBUTE_ENCRYPTION_KEY=%s\n' \
            "$(openssl rand -hex 16)" >> .env
    fi
    if ! grep -q '^SECRET_KEY_BASE=' .env; then
        printf 'SECRET_KEY_BASE=%s\n' "$(openssl rand -hex 64)" >> .env
    fi
    if ! grep -q '^OCTOBOX_BACKGROUND_JOBS_ENABLED=' .env; then
        printf 'OCTOBOX_BACKGROUND_JOBS_ENABLED=true\n' >> .env
    fi
    cat > docker-compose.override.yml <<EOF
    # Auto-generated by mrf $MR_NAME; edit groups.d/27-git instead.
    services:
      app:
        profiles:
          - docker-app
        ports: !override
          - "127.0.0.1:3331:3000"
        environment:
          OCTOBOX_ATTRIBUTE_ENCRYPTION_KEY: \${OCTOBOX_ATTRIBUTE_ENCRYPTION_KEY}
          FETCH_SUBJECT: "true"
          INCLUDE_COMMENTS: "true"
          RAILS_ENV: production
          RAILS_LOG_TO_STDOUT: "true"
          RAILS_SERVE_STATIC_FILES: "true"
          SECRET_KEY_BASE: \${SECRET_KEY_BASE}

      # Restart after docker daemon restarts; the systemd unit only
      # starts these in ExecStartPre, so puma would otherwise outlive them.
      database.service.octobox.internal:
        restart: unless-stopped
        ports:
          - "127.0.0.1:5433:5432"

      redis.service.octobox.internal:
        restart: unless-stopped
        ports:
          - "127.0.0.1:6380:6379"
    EOF
    ensure_symlink_exists "$HOME/bin/octobox-oauth-setup" \
        "$HOME/.config/mr/scripts/octobox-oauth-setup"
    bundle=$(command -v bundle.ruby4.0 || command -v bundle)
    docker=$(command -v docker)
    bundle_path="$HOME/.cache/bundle/octobox-ruby-$(cat .ruby-version)"
    mkdir -p "$HOME/.local/libexec" ~/.config/systemd/user
    cat >"$HOME/.local/libexec/octobox-server" <<EOF
    #!/bin/sh
    set -eu

    cd "\${OCTOBOX_SOURCE_PATH:-$MR_REPO}"
    export BUNDLE_PATH="$bundle_path"

    case "\${1:-server}" in
        install) exec "$bundle" install ;;
        migrate) exec env RAILS_ENV=production "$bundle" exec rails db:migrate ;;
        server) exec "$bundle" exec rails server -b 127.0.0.1 -p 3331 ;;
        sidekiq) exec "$bundle" exec sidekiq -C config/sidekiq.yml ;;
        *) echo "Usage: octobox-server {install|migrate|server|sidekiq}" >&2; exit 2 ;;
    esac
    EOF
    chmod +x "$HOME/.local/libexec/octobox-server"
    cat >~/.config/systemd/user/octobox.service <<EOF
    [Unit]
    Description=Octobox GitHub notifications web UI
    Documentation=https://github.com/octobox/octobox
    ConditionPathExists=$MR_REPO/docker-compose.yml
    StartLimitIntervalSec=0

    # Auto-generated by mrf $MR_NAME at `date`; edit the fixups in
    # ~/.config/mr/groups.d/27-git rather than this file.

    [Service]
    Type=exec
    WorkingDirectory=$MR_REPO
    EnvironmentFile=-$MR_REPO/.env
    Environment=FETCH_SUBJECT=true
    Environment=INCLUDE_COMMENTS=true
    Environment=OCTOBOX_DATABASE_HOST=127.0.0.1
    Environment=OCTOBOX_DATABASE_NAME=postgres
    Environment=OCTOBOX_DATABASE_PASSWORD=development
    Environment=OCTOBOX_DATABASE_PORT=5433
    Environment=OCTOBOX_DATABASE_USERNAME=postgres
    Environment=RAILS_ENV=development
    Environment=REDIS_URL=redis://127.0.0.1:6380
    ExecStartPre=$docker info
    ExecStartPre=$docker compose up -d database.service.octobox.internal redis.service.octobox.internal
    ExecStartPre=$HOME/.local/libexec/octobox-server install
    ExecStartPre=$HOME/.local/libexec/octobox-server migrate
    ExecStart=$HOME/.local/libexec/octobox-server server
    ExecStopPost=$docker compose stop database.service.octobox.internal redis.service.octobox.internal
    Restart=on-failure
    RestartSec=10s
    TimeoutStartSec=10min
    TimeoutStopSec=30s

    [Install]
    WantedBy=default.target
    EOF
    cat >~/.config/systemd/user/octobox-sidekiq.service <<EOF
    [Unit]
    Description=Octobox background job worker (sidekiq)
    Documentation=https://github.com/octobox/octobox
    ConditionPathExists=$MR_REPO/docker-compose.yml
    StartLimitIntervalSec=0

    # Auto-generated by mrf $MR_NAME at `date`; edit the fixups in
    # ~/.config/mr/groups.d/27-git rather than this file.

    # Webhook events land in redis via octobox.service and are processed here,
    # so this must share that unit's REDIS_URL and database settings exactly.
    After=octobox.service
    BindsTo=octobox.service

    [Service]
    Type=exec
    WorkingDirectory=$MR_REPO
    EnvironmentFile=-$MR_REPO/.env
    Environment=FETCH_SUBJECT=true
    Environment=INCLUDE_COMMENTS=true
    Environment=OCTOBOX_BACKGROUND_JOBS_ENABLED=true
    Environment=OCTOBOX_DATABASE_HOST=127.0.0.1
    Environment=OCTOBOX_DATABASE_NAME=postgres
    Environment=OCTOBOX_DATABASE_PASSWORD=development
    Environment=OCTOBOX_DATABASE_PORT=5433
    Environment=OCTOBOX_DATABASE_USERNAME=postgres
    Environment=RAILS_ENV=development
    Environment=REDIS_URL=redis://127.0.0.1:6380
    ExecStart=$HOME/.local/libexec/octobox-server sidekiq
    Restart=on-failure
    RestartSec=10s
    TimeoutStopSec=30s

    [Install]
    WantedBy=default.target
    EOF
    systemctl --user daemon-reload
    systemctl --user enable octobox.service octobox-sidekiq.service
    systemctl --user restart octobox.service octobox-sidekiq.service
    if ! grep -Eq '^GITHUB_CLIENT_ID=.+$' .env ||
       ! grep -Eq '^GITHUB_CLIENT_SECRET=.+$' .env; then
        echo "GitHub login needs OAuth credentials in $MR_REPO/.env." >&2
        echo "Use http://localhost:3331 and callback http://localhost:3331/auth/github/callback." >&2
    fi

