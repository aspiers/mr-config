#!/usr/bin/env bash
# Kept separate from Octobox fixups so installing supervision cannot touch secrets.
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 || ${2:-} != "" && ${2:-} != --no-activate ]]; then
    echo "Usage: ${0##*/} OCTOBOX_CHECKOUT [--no-activate]" >&2
    exit 2
fi
repo_dir=$(cd "$1" && pwd)
script_dir=$(cd "$(dirname "$0")" && pwd)
[[ -f $repo_dir/docker-compose.yml ]] || { echo "Not an Octobox checkout" >&2; exit 2; }
python=$(command -v python3)
command -v redis-cli >/dev/null
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
mkdir -p "$HOME/bin" "$unit_dir"
link=$HOME/bin/octobox-sync-watchdog
if [[ -e $link && ! -L $link ]]; then
    echo "Refusing to replace an existing non-symlink watchdog" >&2
    exit 1
fi
ln -sfn "$script_dir/octobox-sync-watchdog" "$link"

cat >"$unit_dir/octobox-sync-watchdog.service" <<EOF
[Unit]
Description=Recover an Octobox notification sync exceeding ten minutes
ConditionPathExists=$repo_dir/docker-compose.yml

# Auto-generated by install-octobox-sync-watchdog; edit its source in mr-config.

[Service]
Type=oneshot
StateDirectory=octobox-sync-watchdog
StateDirectoryMode=0700
Environment=REDIS_URL=redis://127.0.0.1:6380
ExecStart=$python "$link"
TimeoutStartSec=55s
EOF

cat >"$unit_dir/octobox-sync-watchdog.timer" <<EOF
[Unit]
Description=Check Octobox notification-sync execution every minute

# Auto-generated by install-octobox-sync-watchdog; edit its source in mr-config.

[Timer]
OnStartupSec=1min
OnUnitActiveSec=1min
AccuracySec=1s

[Install]
WantedBy=timers.target
EOF

if [[ ${2:-} != --no-activate ]]; then
    systemctl --user daemon-reload
    systemctl --user enable --now octobox-sync-watchdog.timer
fi
