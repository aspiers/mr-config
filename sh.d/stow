# -*- mode: sh -*-

# Helper functions for installing packages via GNU Stow.

# Never stow tool caches (.pytest_cache, .ruff_cache, __pycache__, ...) or
# ai-safe-rm's per-repository .safe-rm backups into the target.  These go on the command line rather than in
# .stow-global-ignore because a package's .stow-local-ignore replaces the
# global list, while --ignore applies on top of either.  Each pattern must
# start at a path component, or it would also match scripts such as
# bin/clear-dpy-cache.
MR_STOW_OPTIONS="${MR_STOW_OPTIONS:+$MR_STOW_OPTIONS }--ignore=(^|/)\.[^/]*[_-]cache --ignore=(^|/)__pycache__ --ignore=(^|/)\.safe-rm"

mr_init_stow_package () {
    : ${STOW_PKG_TYPE:=directory}
    STOW_NO_AUTOMATIC_ACTIONS=yes
    set_stow_common_opts
}

mr_stow_info_hooks () {
    mr_pre_unstow () {
        stow_uninstall_info
    }
    mr_post_stow () {
        stow_install_info
    }
}

# These are intended to be called from the mr_pre_unstow and
# mr_post_stow hooks supported by the stow plug-in module for mr.

stow_uninstall_info () {
    install-info --delete --quiet --info-dir=$HOME/share/info $STOW_PKG_PATH/share/info/*.info
}

stow_install_info () {
    install-info --info-dir=$HOME/share/info $STOW_PKG_PATH/share/info/*.info
}
